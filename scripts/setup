#!/bin/bash

if [[ -z "$1" ]]; then
    echo "Usage: $0 <project-path>"
    echo "Example: $0 ~/Documents/my-site"
    exit 1
fi

PROJECT_PATH="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

echo "=== Dev IDE Toolkit - Setup ==="
echo ""

echo "Available IDEs:"
echo "  1) vscode"
echo "  2) cursor"
echo "  3) kiro-zed"
echo "  4) antigravity"
read -p "Select IDE (1-4): " IDE_CHOICE

case $IDE_CHOICE in
    1) IDE="vscode" ;;
    2) IDE="cursor" ;;
    3) IDE="kiro-zed" ;;
    4) IDE="antigravity" ;;
    *) echo "Invalid choice"; exit 1 ;;
esac

echo ""
echo "Available Tech Stacks:"
echo "  1) wordpress"
echo "  2) nextjs"
echo "  3) laravel"
echo "  4) nodejs"
read -p "Select Tech Stack (1-4): " TECH_CHOICE

case $TECH_CHOICE in
    1) TECH_STACK="wordpress" ;;
    2) TECH_STACK="nextjs" ;;
    3) TECH_STACK="laravel" ;;
    4) TECH_STACK="nodejs" ;;
    *) echo "Invalid choice"; exit 1 ;;
esac

echo ""
echo "Available Role Profiles:"
echo "  1) fe-dev"
echo "  2) be-dev"
echo "  3) cloud-dev"
read -p "Select Role Profile (1-3): " ROLE_CHOICE

case $ROLE_CHOICE in
    1) ROLE_PROFILE="fe-dev" ;;
    2) ROLE_PROFILE="be-dev" ;;
    3) ROLE_PROFILE="cloud-dev" ;;
    *) echo "Invalid choice"; exit 1 ;;
esac

IDE_DIR="$ROOT_DIR/ide-configs/$IDE"
TECH_STACK_DIR="$ROOT_DIR/tech-stacks/$TECH_STACK"
ROLE_PROFILE_DIR="$ROOT_DIR/role-profiles/$ROLE_PROFILE"
TARGET_DIR="$PROJECT_PATH/$IDE"

if [[ ! -d "$IDE_DIR" ]]; then
    echo "Error: IDE config not found: $IDE_DIR"
    exit 1
fi

if [[ ! -d "$TECH_STACK_DIR" ]]; then
    echo "Error: Tech stack not found: $TECH_STACK_DIR"
    exit 1
fi

if [[ ! -d "$ROLE_PROFILE_DIR" ]]; then
    echo "Error: Role profile not found: $ROLE_PROFILE_DIR"
    exit 1
fi

if [[ ! -d "$PROJECT_PATH" ]]; then
    echo "Error: Project path not found: $PROJECT_PATH"
    exit 1
fi

echo ""
echo "Copying configs to $TARGET_DIR..."

mkdir -p "$TARGET_DIR"

cp -r "$IDE_DIR"/* "$TARGET_DIR/"
echo "  ✓ IDE config: $IDE"

mkdir -p "$TARGET_DIR/tech-stack"
cp -r "$TECH_STACK_DIR"/* "$TARGET_DIR/tech-stack/"
echo "  ✓ Tech stack: $TECH_STACK"

mkdir -p "$TARGET_DIR/role-profile"
cp -r "$ROLE_PROFILE_DIR"/* "$TARGET_DIR/role-profile/"
echo "  ✓ Role profile: $ROLE_PROFILE"

echo ""
echo "Done! Project structure:"
echo "  $TARGET_DIR/"
echo "    ├── (IDE config files)"
echo "    ├── tech-stack/"
echo "    └── role-profile/"
