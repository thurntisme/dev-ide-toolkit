#!/bin/bash

if [[ -z "$1" ]]; then
    echo "Usage: $0 <project-path>"
    echo "Example: $0 ~/Documents/my-site"
    exit 1
fi

PROJECT_PATH="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

echo "=== Dev IDE Toolkit - Setup ==="
echo ""

echo "What do you want to run?"
echo "  1) ai-agent"
echo "  2) settings"
echo "  3) all"
read -p "Select option (1-3): " RUN_OPTION

case $RUN_OPTION in
    1) RUN_CHOICE="ai-agent" ;;
    2) RUN_CHOICE="settings" ;;
    3) RUN_CHOICE="all" ;;
    *) echo "Invalid choice"; exit 1 ;;
esac

echo ""
echo "Available IDEs:"
echo "  1) vscode"
echo "  2) cursor"
echo "  3) kiro-zed"
echo "  4) antigravity"
echo "  5) opencode"
read -p "Select IDE (1-5): " IDE_CHOICE

case $IDE_CHOICE in
    1) IDE="vscode" ;;
    2) IDE="cursor" ;;
    3) IDE="kiro-zed" ;;
    4) IDE="antigravity" ;;
    5) IDE="opencode" ;;
    *) echo "Invalid choice"; exit 1 ;;
esac

if [[ "$IDE" == "opencode" ]]; then
    TARGET_DIR="$PROJECT_PATH/.opencode"
else
    TARGET_DIR="$PROJECT_PATH/$IDE"
fi
IDE_CONFIG_DIR="$ROOT_DIR/ide-configs/$IDE"
AI_AGENT_DIR="$ROOT_DIR/ai-agent/ide-index/$IDE"

if [[ ! -d "$PROJECT_PATH" ]]; then
    echo "Error: Project path not found: $PROJECT_PATH"
    exit 1
fi

if [[ "$RUN_CHOICE" == "settings" ]] || [[ "$RUN_CHOICE" == "all" ]]; then
    if [[ ! -d "$IDE_CONFIG_DIR" ]]; then
        echo "Error: IDE config not found: $IDE_CONFIG_DIR"
        exit 1
    fi
fi

if [[ "$RUN_CHOICE" == "ai-agent" ]] || [[ "$RUN_CHOICE" == "all" ]]; then
    if [[ "$IDE" != "opencode" ]] && [[ ! -d "$AI_AGENT_DIR" ]]; then
        echo "Error: AI agent config not found: $AI_AGENT_DIR"
        exit 1
    fi
fi

echo ""
echo "Copying configs to $TARGET_DIR..."

mkdir -p "$TARGET_DIR"

if [[ "$RUN_CHOICE" == "ai-agent" ]] || [[ "$RUN_CHOICE" == "all" ]]; then
    if [[ "$IDE" == "antigravity" ]]; then
        mkdir -p "$PROJECT_PATH/.agent"
        cp -r "$AI_AGENT_DIR"/* "$PROJECT_PATH/.agent/"
        cp -r "$ROOT_DIR/ai-agent/shared"/* "$PROJECT_PATH/.agent/"
        if [[ -f "$PROJECT_PATH/.agent/AGENTS.md" ]]; then
            mv "$PROJECT_PATH/.agent/AGENTS.md" "$PROJECT_PATH/AGENTS.md"
        fi
        rm -rf "$PROJECT_PATH/.agent/antigravity"
        echo "  ✓ ai-agent (.agent)"
    elif [[ "$IDE" == "opencode" ]]; then
        mkdir -p "$PROJECT_PATH/.opencode"
        cp -r "$ROOT_DIR/ai-agent/shared"/* "$PROJECT_PATH/.opencode/"
        echo "  ✓ ai-agent (.opencode)"
    else
        cp -r "$AI_AGENT_DIR"/* "$TARGET_DIR/"
        echo "  ✓ ai-agent"
    fi
fi

if [[ "$RUN_CHOICE" == "settings" ]] || [[ "$RUN_CHOICE" == "all" ]]; then
    cp -r "$IDE_CONFIG_DIR"/* "$TARGET_DIR/"
    echo "  ✓ settings"
fi

if [[ "$IDE" == "antigravity" ]] && [[ -d "$TARGET_DIR" ]]; then
    rm -rf "$TARGET_DIR"
fi

echo ""
echo "Done! Project structure:"
echo "  $TARGET_DIR/"
if [[ "$RUN_CHOICE" == "ai-agent" ]] || [[ "$RUN_CHOICE" == "all" ]]; then
    if [[ "$IDE" == "antigravity" ]]; then
        echo "    ├── .agent/"
    elif [[ "$IDE" == "opencode" ]]; then
        echo "    ├── .opencode/"
    else
        echo "    ├── (ai-agent files)"
    fi
fi
if [[ "$RUN_CHOICE" == "settings" ]] || [[ "$RUN_CHOICE" == "all" ]]; then
    echo "    └── (IDE config files)"
fi
