    "WordPress Shortcode": {
        "prefix": "dit-wp-shortcode",
        "body": [
            "function ${1:prefix}_${2:shortcode}_shortcode( $atts ) {",
            "    $atts = shortcode_atts( array(",
            "        '${3:key}' => '${4:default value}',",
            "    ), $atts, '${2:shortcode}' );",
            "",
            "    ob_start();",
            "    ?>",
            "    $5",
            "    <?php",
            "    return ob_get_clean();",
            "}",
            "add_shortcode( '${2:shortcode}', '${1:prefix}_${2:shortcode}_shortcode' );"
        ],
        "description": "Create a shortcode"
    },
    "WordPress Enqueue Script": {
        "prefix": "dit-wp-enqueue-script",
        "body": [
            "function ${1:prefix}_enqueue_scripts() {",
            "    wp_enqueue_style(",
            "        '${2:handle}',",
            "        get_template_directory_uri() . '/${3:assets/css/style.css}',",
            "        array(),",
            "        '${4:1.0.0}'",
            "    );",
            "",
            "    wp_enqueue_script(",
            "        '${5:handle}',",
            "        get_template_directory_uri() . '/${6:assets/js/main.js}',",
            "        array(),",
            "        '${4:1.0.0}',",
            "        true",
            "    );",
            "}",
            "add_action( 'wp_enqueue_scripts', '${1:prefix}_enqueue_scripts' );"
        ],
        "description": "Enqueue scripts and styles"
    },
    "WordPress Ajax Handler": {
        "prefix": "dit-wp-ajax",
        "body": [
            "add_action( 'wp_ajax_${1:action}', '${2:prefix}_${1:action}_callback' );",
            "add_action( 'wp_ajax_nopriv_${1:action}', '${2:prefix}_${1:action}_callback' );",
            "",
            "function ${2:prefix}_${1:action}_callback() {",
            "    check_ajax_referer( '${3:nonce_action}', '${4:nonce}' );",
            "",
            "    $response = array(",
            "        'success' => true,",
            "        'data'    => $_POST,",
            "    );",
            "",
            "    wp_send_json( $response );",
            "    wp_die();",
            "}"
        ],
        "description": "Create an AJAX handler"
    },
    "WordPress REST API Endpoint": {
        "prefix": "dit-wp-rest-endpoint",
        "body": [
            "add_action( 'rest_api_init', function() {",
            "    register_rest_route( '${1:namespace}', '/${2:route}', array(",
            "        'methods'  => '${3:GET}',",
            "        'callback' => '${4:prefix}_${2:route}_callback',",
            "        'permission_callback' => '__return_true',",
            "    ) );",
            "} );",
            "",
            "function ${4:prefix}_${2:route}_callback( WP_REST_Request $request ) {",
            "    return new WP_REST_Response( array(",
            "        'success' => true,",
            "        'message' => '${5:Hello World}',",
            "    ), 200 );",
            "}"
        ],
        "description": "Create a REST API endpoint"
    },
    "WordPress CPT UI Meta Box": {
        "prefix": "dit-wp-metabox",
        "body": [
            "add_action( 'add_meta_boxes', '${1:prefix}_${2:metabox}_add_meta_box' );",
            "add_action( 'save_post', '${1:prefix}_${2:metabox}_save_meta_box' );",
            "",
            "function ${1:prefix}_${2:metabox}_add_meta_box() {",
            "    add_meta_box(",
            "        '${2:metabox}_id',",
            "        __( '${3:Meta Box Title}', '${4:text-domain}' ),",
            "        '${1:prefix}_${2:metabox}_html',",
            "        '${5:post}',",
            "        'normal',",
            "        'high'",
            "    );",
            "}",
            "",
            "function ${1:prefix}_${2:metabox}_html( $post ) {",
            "    $value = get_post_meta( $post->ID, '_${2:metabox}_key', true );",
            "    wp_nonce_field( '${1:prefix}_${2:metabox}_save_meta_box', '${1:prefix}_${2:metabox}_nonce' );",
            "    ?>",
            "    <label for=\"${2:metabox}_field\">${3:Field Label}</label>",
            "    <input type=\"text\" id=\"${2:metabox}_field\" name=\"${2:metabox}_field\" value=\"<?php echo esc_attr( $value ); ?>\" style=\"width: 100%;\">",
            "    <?php",
            "}",
            "",
            "function ${1:prefix}_${2:metabox}_save_meta_box( $post_id ) {",
            "    if ( ! isset( $_POST['${1:prefix}_${2:metabox}_nonce'] ) || ! wp_verify_nonce( $_POST['${1:prefix}_${2:metabox}_nonce'], '${1:prefix}_${2:metabox}_save_meta_box' ) ) {",
            "        return;",
            "    }",
            "    if ( defined( 'DOING_AUTOSAVE' ) && DOING_AUTOSAVE ) {",
            "        return;",
            "    }",
            "    if ( isset( $_POST['post_type'] ) && 'page' == $_POST['post_type'] ) {",
            "        if ( ! current_user_can( 'edit_page', $post_id ) ) {",
            "            return;",
            "        }",
            "    } else {",
            "        if ( ! current_user_can( 'edit_post', $post_id ) ) {",
            "            return;",
            "        }",
            "    }",
            "    if ( isset( $_POST['${2:metabox}_field'] ) ) {",
            "        update_post_meta( $post_id, '_${2:metabox}_key', sanitize_text_field( $_POST['${2:metabox}_field'] ) );",
            "    }",
            "}",
            ""
        ],
        "description": "Create a meta box for CPT"
    }
}
